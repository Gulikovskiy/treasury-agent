{
  "name": "treasury-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "collect": "tsx collect-all.ts",
    "manifest": "tsx collectors/manifest.ts",
    "balances": "tsx collectors/balances.ts",
    "transactions": "tsx collectors/transactions.ts",
    "prices": "tsx collectors/prices.ts",
    "nav": "tsx collectors/nav.ts",
    "defi": "tsx collectors/defi-positions.ts",
    "metadata": "tsx collectors/metadata.ts",
    "labels": "tsx collectors/labels.ts",
    "ground-truth": "tsx ground-truth.ts",
    "ground-truth:update": "tsx ground-truth.ts --write",
    "groundedness": "node --import tsx src/groundedness.ts",
    "eval": "node --import tsx src/eval.ts",
    "eval:score": "node --import tsx src/eval.ts --score-only traces.jsonl",
    "run:all": "node --import tsx src/run-all.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "4.66.0",
    "@ai-sdk/anthropic": "^4.0.44",
    "ai": "^7.0.83",
    "dotenv": "17.2.2",
    "viem": "2.55.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
