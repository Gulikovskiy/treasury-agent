ALCHEMY_API_KEY=your_alchemy_key

# Optional. Routescan and Blockscout are keyless on the free tier; a key raises limits.
ROUTESCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# First collection only. If omitted, collector uses now ~ 5 minutes.
SNAPSHOT_TIMESTAMP=2026-08-24T15:00:00Z

FIXTURE_DIR=./fixtures/treasury_v1
LOOKBACK_DAYS=90
